{
  "name": "familyagenda",
  "private": true,
  "version": "0.1.0",
  "description": "Agenda partagé multi-utilisateurs (PWA, hors-ligne, notifications push)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w client"
  },
  "engines": {
    "node": ">=22.5"
  }
}
